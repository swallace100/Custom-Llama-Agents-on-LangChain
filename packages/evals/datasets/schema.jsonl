{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Role Instruction Example",
  "type": "object",
  "required": ["role", "task_id", "instruction", "output", "source", "quality"],
  "additionalProperties": true,
  "properties": {
    "role": { "type": "string", "enum": ["researcher", "writer", "editor"] },
    "task_id": { "type": "string", "minLength": 1 },
    "instruction": { "type": "string", "minLength": 10 },
    "context": { "type": ["string", "null"] },
    "output": { "type": "string", "minLength": 10 },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "default": []
    },
    "source": { "type": "string", "enum": ["manual", "synthetic", "internal"] },
    "quality": { "type": "integer", "minimum": 1, "maximum": 5 },
    "notes": { "type": ["string", "null"] }
  }
}
