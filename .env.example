# === API service ===
PORT=8080
LOG_LEVEL=info

# === Model / API keys ===
OPENAI_API_KEY=
LLAMA_SERVER_URL=http://localhost:8000
EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2

# === Default: Ollama local ===
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=none
LLM_MODEL=llama3:8b-instruct-q4_K_M
LLM_CONTEXT=4096
LLM_TEMPERATURE=0.2

# === Cloud: OpenAI ===
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
# LLM_CONTEXT=8192
# LLM_TEMPERATURE=0.2

# === Databases ===
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

MONGO_INITDB_ROOT_USERNAME=
MONGO_INITDB_ROOT_PASSWORD=
MONGO_HOST=localhost
MONGO_PORT=27017

# === Vector store ===
CHROMA_HOST=localhost
CHROMA_PORT=8001

# === GitHub integration ===
GITHUB_TOKEN=

# === Misc ===
ENV=development
