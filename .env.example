# === API service ===
PORT=8080
LOG_LEVEL=info

# === Model / API keys ===
OPENAI_API_KEY=

# === Default: Local Phi-3 mini host ===
LLM_PROVIDER=phi3
LLM_BASE_URL=http://localhost:7001
LLM_API_KEY=none
LLM_MODEL=microsoft/phi-3-mini-4k-instruct
LLM_CONTEXT=4096
LLM_TEMPERATURE=0.2

# === Cloud: OpenAI (optional override) ===
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
# LLM_CONTEXT=8192
# LLM_TEMPERATURE=0.2

# === Embeddings model ===
EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2

# === Databases ===
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

MONGO_INITDB_ROOT_USERNAME=
MONGO_INITDB_ROOT_PASSWORD=
MONGO_HOST=localhost
MONGO_PORT=27017

# === Vector store ===
CHROMA_HOST=localhost
CHROMA_PORT=8001

# === GitHub integration ===
GITHUB_TOKEN=

# === Misc ===
ENV=development
