# apps/demo/Dockerfile.dev
FROM node:20-slim

# Use pnpm via Corepack
RUN corepack enable && corepack prepare pnpm@9.6.0 --activate

# Use a repo-like structure inside the image so pnpm "workspace" works
WORKDIR /repo

# 1) copy workspace metadata + lockfile (for reproducible installs)
COPY pnpm-workspace.yaml pnpm-lock.yaml ./

# 2) copy ONLY this app's package.json first (cache-friendly)
COPY apps/demo/package.json apps/demo/package.json

# 3) install deps for this workspace project only
RUN pnpm install --filter ./apps/demo...

# 4) now bring in the app source (bind-mounted in compose for live dev anyway)
COPY apps/demo ./apps/demo

EXPOSE 5173
CMD ["pnpm", "--filter", "./apps/demo", "dev", "--", "--host", "0.0.0.0"]
