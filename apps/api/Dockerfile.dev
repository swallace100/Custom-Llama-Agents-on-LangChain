FROM python:3.11-slim
WORKDIR /app

# copy the API lockfile
COPY apps/api/requirements.txt requirements/requirements.txt

# (optional) also copy the repo-level dev lockfile if you want dev tools inside the container
# comment this next line out if you don’t want dev deps in the image
COPY requirements-dev.txt requirements/requirements-dev.txt

# install deps
RUN pip install --no-cache-dir -r requirements/requirements.txt \
    && if [ -f requirements/requirements-dev.txt ]; then \
    pip install --no-cache-dir -r requirements/requirements-dev.txt; \
    fi

# copy source
COPY apps/api /app

EXPOSE 8080
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8080", "--reload"]
